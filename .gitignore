# Secrets: the OpenAI key lives only here (see .env.example).
.env

# Python
venv/
.venv/
__pycache__/
*.pyc

# Local data built at upload time (indexes and stored paper texts)
chroma_db/
paper_store/

# Evaluation results can hold the text of third-party papers (some under publisher copyright).
# Files already tracked before this rule stay tracked.
eval/results/*.json
# A judge log with local file paths in a traceback; kept locally.
eval/results/run1_original_judge_log.txt

# Third-party papers used only as test filler
samples/filler/
samples/long/

# Prompt-injection test files: modified copies of the vitamin D paper (CC BY-NC-ND forbids sharing
# them), made locally by eval/make_injection_samples.py.
samples/injection/

# Voice question recordings (the author's voice), kept locally.
samples/voice/

# Office lock files and macOS metadata
~$*
.DS_Store
CLAUDE.md
